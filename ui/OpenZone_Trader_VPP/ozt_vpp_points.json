                        "bg": "$vppAccent",
                        "edge": "$vppAccent",
                        "color": "$vppScreen",
                        "anchor": "right"
                      }
                    }
                  ],
                  "anchor": "bottom",
                  "note": "The draft of the trader's three files, shared by every page that edits them; the script writes the state."
                }
