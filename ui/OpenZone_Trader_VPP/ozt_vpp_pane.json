{
  "layout": "ozt_vpp_pane",
  "note": "TRADERS pane of the OpenZone admin window -- its own pbo (OpenZone_Trader_VPP) and its own layout: a server without VPP never loads it, and the core must not know the pane exists. OZT_VppPane.OnCreate builds it under M_SUB_WIDGET and calls RegisterPane(traders, TRADERS, pane, TrdHint), so the root stands at [0, vpp.paneY] and starts hidden, like the core's panes. Names OZT_VppPane.c resolves by string: TrdList, TrdCatsKnown, TrdInfo, BtnTrdKindText, BtnTrdChangeText through FindAnyWidget; TrdId, TrdName, TrdClass, TrdRadius, TrdBuy, TrdSell, TrdProvider, TrdCats through the inherited SetEdit/GetEdit; and the buttons dispatched in OnClick: BtnTrdPlace, BtnTrdMove, BtnTrdTurn, BtnTrdRemove, BtnTrdOutfit, BtnTrdRespawn, BtnTrdRefresh, BtnTrdKind, BtnTrdChange, BtnTrdSave, BtnTrdAdopt. Console captions stay English, as in every pane of the window.",
  "root": {
    "frame": {
      "name": "PaneTraders",
      "size": "$vpp.pane",
      "at": [0, "$vpp.paneY"],
      "inset": "$vpp.inset",
      "hidden": true,
      "priority": 2,
      "children": [
        {
          "vbox": {
            "name": "TrdBody",
            "gap": "$space.gap",
            "children": [
              {
                "hbox": {
                  "name": "TrdCols",
                  "h": 440,
                  "gap": "$space.column",
                  "children": [
                    {
                      "vbox": {
                        "name": "TrdListCol",
                        "w": 470,
                        "gap": "$space.tight",
                        "children": [
                          { "listbox": { "name": "TrdList", "h": "fill", "font": "field", "color": "$text", "props": { "title visible": false, "highlight row": true, "lines": 12 } } },
                          {
                            "hbox": {
                              "name": "TrdActs",
                              "h": "$size.button",
                              "gap": "$space.tight",
                              "children": [
                                { "button": { "name": "BtnTrdPlace", "w": 112, "text": "PLACE HERE", "edge": "$ok", "color": "$ok" } },
                                { "button": { "name": "BtnTrdMove", "w": 112, "text": "MOVE HERE" } },
                                { "button": { "name": "BtnTrdTurn", "w": 112, "text": "TURN AS I" } },
                                { "button": { "name": "BtnTrdRemove", "w": 116, "text": "REMOVE", "edge": "$bad", "color": "$bad" } }
                              ]
                            }
                          },
                          {
                            "hbox": {
                              "name": "TrdActs2",
                              "h": "$size.button",
                              "gap": "$space.tight",
                              "children": [
                                { "button": { "name": "BtnTrdOutfit", "w": 152, "text": "OUTFIT FROM ME" } },
                                { "button": { "name": "BtnTrdRespawn", "w": 152, "text": "RESPAWN ALL" } },
                                { "button": { "name": "BtnTrdRefresh", "w": 154, "text": "REFRESH" } }
                              ]
                            }
                          },
                          {
                            "hbox": {
                              "name": "TrdActs3",
                              "h": "$size.button",
                              "gap": "$space.tight",
                              "children": [
                                { "button": { "name": "BtnTrdAdopt", "w": 470, "text": "AIMED THING BECOMES A TRADER", "edge": "$ok", "color": "$ok", "note": "What the camera points at -- where the admin looked before opening the window -- becomes a point of kind map (OZT_VppPane.AdoptTrd)." } }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "vbox": {
                        "name": "TrdFormCol",
                        "w": 470,
                        "gap": "$space.tight",
                        "children": [
                          { "hrow": { "name": "TrdIdRow", "h": "$size.button", "children": [
                            { "label": { "name": "TrdIdLbl", "w": 130, "text": "id (new point)", "font": "small", "color": "$muted" } },
                            { "field": { "name": "TrdId", "w": 330 } } ] } },
                          { "hrow": { "name": "TrdNameRow", "h": "$size.button", "children": [
                            { "label": { "name": "TrdNameLbl", "w": 130, "text": "name", "font": "small", "color": "$muted" } },
                            { "field": { "name": "TrdName", "w": 330 } } ] } },
                          { "hrow": { "name": "TrdKindRow", "h": "$size.button", "children": [
                            { "label": { "name": "TrdKindLbl", "w": 130, "text": "kind", "font": "small", "color": "$muted" } },
                            { "button": { "name": "BtnTrdKind", "w": 330, "text": "KIND: object" } } ] } },
                          { "hrow": { "name": "TrdClassRow", "h": "$size.button", "children": [
                            { "label": { "name": "TrdClassLbl", "w": 130, "text": "class", "font": "small", "color": "$muted" } },
                            { "field": { "name": "TrdClass", "w": 330 } } ] } },
                          { "hrow": { "name": "TrdRadiusRow", "h": "$size.button", "children": [
                            { "label": { "name": "TrdRadiusLbl", "w": 130, "text": "radius, m", "font": "small", "color": "$muted" } },
                            { "field": { "name": "TrdRadius", "w": 330 } } ] } },
                          { "hrow": { "name": "TrdFactorRow", "h": "$size.button", "children": [
                            { "label": { "name": "TrdFactorLbl", "w": 130, "text": "buy x, sell x", "font": "small", "color": "$muted" } },
                            { "field": { "name": "TrdBuy", "w": 162 } },
                            { "field": { "name": "TrdSell", "w": 162 } } ] } },
                          { "hrow": { "name": "TrdMoneyRow", "h": "$size.button", "children": [
                            { "label": { "name": "TrdMoneyLbl", "w": 130, "text": "money provider", "font": "small", "color": "$muted" } },
                            { "field": { "name": "TrdProvider", "w": 330 } } ] } },
                          { "hrow": { "name": "TrdCatsRow", "h": "$size.button", "children": [
                            { "label": { "name": "TrdCatsLbl", "w": 130, "text": "categories", "font": "small", "color": "$muted" } },
                            { "field": { "name": "TrdCats", "w": 330 } } ] } },
                          { "text": { "name": "TrdCatsKnown", "w": 470, "h": 34, "plain": true, "grow": false, "font": "tiny", "color": "$muted", "text": "categories of the price book: -" } },
                          { "hrow": { "name": "TrdChangeRow", "h": "$size.button", "children": [
                            { "label": { "name": "TrdChangeLbl", "w": 130, "text": "change tab", "font": "small", "color": "$muted" } },
                            { "button": { "name": "BtnTrdChange", "w": 330, "text": "CHANGES NOTES: yes" } } ] } },
                          { "text": { "name": "TrdInfo", "w": 470, "h": 34, "plain": true, "grow": false, "font": "tiny", "color": "$muted", "text": "pick a point on the list" } },
                          { "button": { "name": "BtnTrdSave", "h": "$size.button", "text": "SAVE POINT", "edge": "$ok", "color": "$ok" } }
                        ]
                      }
                    }
                  ]
                }
              },
              { "label": { "name": "TrdHint", "h": "$size.hint", "font": "hint", "color": "$muted" } }
            ]
          }
        }
      ]
    }
  }
}
