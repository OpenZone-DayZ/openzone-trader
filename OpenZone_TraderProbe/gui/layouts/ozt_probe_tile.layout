// One item tile of the trader probe: a picture of an entity on a dark square.
// Made by script as often as the question asks for.
FrameWidgetClass OZT_ProbeTile {
 ignorepointer 1
 position 0 0
 size 46 46
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 priority 1
 {
  PanelWidgetClass TileBg {
   ignorepointer 1
   color 0.17 0.18 0.2 1
   position 0 0
   size 1 1
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   priority 1
   style rover_sim_colorable
  }
  ItemPreviewWidgetClass TilePic {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   priority 2
  }
 }
}
